### Do not modify these first three ignore rules.  Needed to ignore files with no extension ###
# Ignore all files including binary files that have no extension
*
# Unignore all files with extensions
!*.*
# Unignore all directories
!*/

# Specifically keep these files with no extension
!Earthfile
!authors
!LICENSE*
!legal*
!Dockerfile
# .reuse/dep5 see https://reuse.software/
!dep5
# NotARocFile is used for formatter test
!NotARocFile
# also includes keeping one exe benchmark file
!dynhost_benchmarks*

### Add specific file extensions and directories below ###

# Ignore the following directories and file extensions
target
!src/target
generated-docs
plan.md

zig-out
zig-pkg
.zig-cache
.tmp/
.direnv
.envrc
*.rs.bk
*.o
*.a
*.s
# Hand-written assembly source (the interpreter's hosted-call trampoline), not a build artifact.
!src/eval/host_trampoline.S
*.so
*.so.*
*.obj
*.dll
*.dylib
*.lib
*.def
*.tmp
*.wasm
*.exe
*.pdb

# llvm human-readable output
*.ll
*.bc

# Force-include musl runtime files that are checked into the repo with
# `git add -f`. The build copies these from test/fx into other test
# platforms (e.g. test/static-data-host), so they need to exist in any
# filtered source view (e.g. nix's gitignoreSource).
!test/fx/platform/targets/x64musl/crt1.o
!test/fx/platform/targets/x64musl/libc.a
!test/fx/platform/targets/arm64musl/crt1.o
!test/fx/platform/targets/arm64musl/libc.a

# Force-include the MinGW C runtime files that are checked into the repo
# (see ci/vendor_mingw_runtime.py). A `*mingw` target links only
# what the platform declares, so every mingw target dir needs these next to
# host.lib; build.zig copies them from test/fx into the other test platforms.

!test/fx/platform/targets/x64mingw/advapi32.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-conio-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-convert-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-environment-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-filesystem-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-heap-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-locale-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-math-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-multibyte-l1-1-0.lib
