!test/fx/platform/targets/x64mingw/api-ms-win-crt-process-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-runtime-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-stdio-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-string-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-time-l1-1-0.lib
!test/fx/platform/targets/x64mingw/api-ms-win-crt-utility-l1-1-0.lib
!test/fx/platform/targets/x64mingw/compiler_rt.lib
!test/fx/platform/targets/x64mingw/crt2.obj
!test/fx/platform/targets/x64mingw/dllcrt2.obj
!test/fx/platform/targets/x64mingw/kernel32.lib
!test/fx/platform/targets/x64mingw/libmingw32.lib
!test/fx/platform/targets/x64mingw/ntdll.lib
