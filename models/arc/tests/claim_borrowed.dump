=== LIR <unnamed> (p0, identity=00, fingerprint=00, borrowed=0, ret_borrowed=false, unique=false) ===
proc p0 args=[] ret=u64
  l0:u64 = literal 1
  l1:list#1 = list(l0)
  l2:u64 = literal 5
  l3:struct_#2 = struct(l1, l2)
  l4:tag_union#3 = tag v0 d0 (l3)
  l5:list#1 = call p1(l4)
  l6:u64 = low_level list_len(l5)
  decref l5 rc=concrete(decref,1) single_thread
  decref l4 rc=concrete(decref,3) single_thread
  ret l6

=== LIR first_of (p1, identity=00, fingerprint=00, borrowed=0x1, ret_borrowed=false, unique=false) ===
proc p1 args=[l10:tag_union#3] ret=list#1
  l11:struct_#2 = ref.tag_payload_struct l10 v0
  l12:list#1 = ref.field l11[0]
  ret l12
