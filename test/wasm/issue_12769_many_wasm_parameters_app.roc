app [main!] { pf: platform "./platform/main.roc" }

import pf.FallibleHost

# Every function here has more wasm parameters than a byte can count, so its
# signature only survives if the backend tells it apart from the others:
# `short` has 256 fewer parameters than `long`, and `mixed` differs from `long`
# only in its last parameter. `generic` has no annotation, so without
# specialization it also takes hidden descriptor and dictionary parameters, and
# `literals` reaches the count through hidden literal arguments alone. Each
# result depends on the first, a middle and the last argument, and the
# arguments come from the host so that no call is evaluated at compile time.

