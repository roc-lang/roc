app [main!] { pf: platform "./static-lib-platform/main.roc" }

# A recursion through a call of a closure whose lambda set has 256 members
# (#12922). Each of the 20 levels of `go` runs `apply`, whose call of `f`
# dispatches over every member. The frame of `apply` must not grow with the
# member count, so 20 levels fit a 1 MiB shadow stack and the result is the
# length of the list built along the way.

W : { out : List(U8), a : U64, b : U64, c : U64, d : U64, e : U64 }

apply : W, (W -> W) -> W
apply = |w, f| {
    r = f({ ..w, a: w.a + 1 })
    { ..r, d: r.d + 1 }
}

pick : U64, U64 -> (W -> W)
pick = |k, n|
    match k {
        0 => |w| go(n - 1, { ..w, out: w.out.append(0), b: w.b + 0 })
        1 => |w| go(n - 1, { ..w, out: w.out.append(1), b: w.b + 1 })
        2 => |w| go(n - 1, { ..w, out: w.out.append(2), b: w.b + 2 })
        3 => |w| go(n - 1, { ..w, out: w.out.append(3), b: w.b + 3 })
        4 => |w| go(n - 1, { ..w, out: w.out.append(4), b: w.b + 4 })
