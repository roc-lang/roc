        _ => |w| go(n - 1, { ..w, out: w.out.append(1), b: w.b + 256 })
    }

go : U64, W -> W
go = |n, w|
    if (n == 0) w else {
        r = apply(w, pick(n % 256, n))
        { ..r, c: r.c + 1 }
    }

main! = |seed| {
    len = go(seed + 20, { out: [], a: 0, b: 0, c: 0, d: 0, e: 0 }).out.len()
    "${len.to_str()}"
}
